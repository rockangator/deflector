      "rewrite": "Free trial — check cancellation terms",
      "explanation": "Free trial offers may auto-convert to paid subscriptions."
    },
    {
      "id": "trick-agree-all",
      "category": "trick_question",
      "pattern": "\\b(agree to all|accept all|select all)\\b",
      "confidence": 0.7,
