  ],
  "structuralRules": [
    {
      "id": "countdown-timer",
      "category": "urgency",
      "selector": "[class*='countdown'], [class*='timer'], [class*='Timer'], [data-countdown], [id*='countdown'], [id*='timer']",
      "check": "hasNumericCountdown",
      "confidence": 0.95,
      "explanation": "Countdown timer element detected on page.",
      "rewrite": "Timer — verify if deadline is real"
    },
    {
      "id": "pre-checked-consent",
      "category": "trick_question",
      "selector": "input[type=checkbox]:checked",
      "check": "nearMarketingCopy",
      "confidence": 0.8,
      "explanation": "Pre-checked marketing or consent checkbox.",
      "rewrite": "Review pre-selected consent options"
    },
    {
      "id": "disguised-ad-hidden-label",
      "category": "disguised_ad",
      "selector": "[class*='sponsor'], [class*='promoted'], [class*='advert'], [data-ad], [aria-label*='sponsored' i]",
      "check": "hiddenOrTinyLabel",
      "confidence": 0.85,
      "explanation": "Ad or sponsored label may be visually hidden or minimized.",
      "rewrite": "Sponsored content — disclosure may be obscured"
    },
    {
      "id": "misdirection-low-contrast-decline",
      "category": "misdirection",
      "selector": "[role=dialog] a, [role=dialog] button, .modal a, .modal button, [class*='popup'] a, [class*='popup'] button",
      "check": "lowContrastSecondaryCta",
      "confidence": 0.82,
      "explanation": "Decline or dismiss option appears visually de-emphasized.",
      "rewrite": "Check if decline option is harder to notice"
    },
    {
      "id": "activity-notification-toast",
      "category": "social_proof",
      "selector": "[class*='notification'], [class*='toast'], [class*='activity'], [class*='social-proof'], [class*='recent-purchase']",
      "check": "activityToastPattern",
      "confidence": 0.83,
      "explanation": "Activity notification toast — may show fabricated purchases.",
      "rewrite": "Live activity — unverifiable"
    }
  ],
  "exceptions": [
    { "host": "wikipedia.org", "action": "disable" },
    { "host": "github.com", "action": "disable" },
    { "host": "stackoverflow.com", "action": "disable" },
    { "host": "docs.google.com", "action": "disable" },
    { "pattern": "only \\d+ left", "host": "stackoverflow.com", "action": "ignore" }
  ]
}
