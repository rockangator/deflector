      "explanation": "Subscription or auto-renewal terms that may be easy to miss."
    },
    {
      "id": "urgency-flash-sale",
      "category": "urgency",
      "pattern": "\\b(flash sale|today only|24[- ]hour sale|ends in \\d+ (hours?|minutes?))\\b",
