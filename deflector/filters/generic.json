      "explanation": "Popularity labels without transparent ranking criteria."
    },
    {
      "id": "misdirection-gray-decline",
      "category": "misdirection",
      "pattern": "\\b(maybe later|not now|skip (this )?offer)\\b",
      "confidence": 0.5,
      "rewrite": "Secondary action — check visual prominence",
      "explanation": "Low-confidence: may be paired with visually de-emphasized styling."
